# UpSnap credentials + device selector
UPSNAP_HOST=http://upsnap.stanley.arpa
UPSNAP_CA_CERT=/path/to/certs/ca/ca.crt
UPSNAP_USERNAME=your_email@example.com
UPSNAP_PASSWORD=your_password
UPSNAP_DEVICE_NAME=Windows RTX
# Optional: set if you want to skip the name lookup
# UPSNAP_DEVICE_ID=your_device_id

# Windows SSH connection
WINDOWS_SSH_TARGET=mail@jakestanley.co.uk@192.168.1.4
WINDOWS_SSH_KEY=~/.ssh/id_ed25519

# Optional overrides
WINDOWS_DEMUCS_MODEL=htdemucs
WINDOWS_DEMUCS_DEVICE=cuda
# Optional: point CUDA checks at a specific Python (e.g. pipx venv)
# Use forward slashes or double-backslashes so bash doesn't strip them.
# WINDOWS_PYTHON=C:/Users/mail/pipx/venvs/demucs/Scripts/python.exe
# WINDOWS_PYTHON=C:\\Users\\mail\\pipx\\venvs\\demucs\\Scripts\\python.exe
# Optional: throttle by waiting for GPU temp to cool (C)
# WINDOWS_GPU_MAX_TEMP=80
# WINDOWS_GPU_RESUME_TEMP=70
# Optional: batch size for Windows uploads/runs (default 10)
# WINDOWS_BATCH_SIZE=10
# Optional: PowerToys Awake duration per batch in minutes (default 10)
# WINDOWS_AWAKE_MINUTES=10
# Optional: seconds before auto-sleep prompt (default 120)
# WINDOWS_SLEEP_PROMPT_TIMEOUT=120

# Spotify (spotdl) - Create an app here: https://developer.spotify.com/dashboard
SPOTDL_CLIENT_ID=your_spotify_client_id
SPOTDL_CLIENT_SECRET=your_spotify_client_secret
